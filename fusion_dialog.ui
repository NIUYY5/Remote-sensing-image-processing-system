           </layout>
          </widget>
         </widget>
        </item>
       </layout>
      </widget>
      <widget class="QWidget" name="evaluationTab">
       <attribute name="title">
        <string>质量评估</string>
       </attribute>
       <layout class="QVBoxLayout" name="evaluationTabLayout">
        <item>
         <widget class="QTextEdit" name="evaluationTextEdit">
