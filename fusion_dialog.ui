<?xml version="1.0" encoding="UTF-8"?>
<UI version="4.0">
 <class>FusionDialog</class>
 <widget class="QDialog" name="FusionDialog">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>1200</width>
    <height>800</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>影像融合</string>
  </property>
  <property name="windowIcon">
   <iconset resource="moban.qrc">
    <normaloff>icons/image_fusion.svg</normaloff>icons/image_fusion.svg</iconset>
  </property>
  <layout class="QVBoxLayout" name="mainLayout">
   <item>
    <widget class="QSplitter" name="mainSplitter">
     <property name="orientation">
      <enum>Qt::Horizontal</enum>
     </property>
     <widget class="QWidget" name="leftPanel">
      <layout class="QVBoxLayout" name="leftPanelLayout">
       <item>
        <widget class="QGroupBox" name="inputGroup">
         <property name="title">
          <string>输入影像</string>
         </property>
         <layout class="QFormLayout" name="inputFormLayout">
          <item row="0" column="0">
           <widget class="QLabel" name="panLabel">
            <property name="text">
             <string>全色影像:</string>
            </property>
           </widget>
          </item>
          <item row="0" column="1">
           <layout class="QHBoxLayout" name="panLayout">
            <item>
             <widget class="QLineEdit" name="panPathEdit">
              <property name="readOnly">
               <bool>true</bool>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QPushButton" name="panBrowseBtn">
              <property name="text">
               <string>浏览...</string>
              </property>
             </widget>
            </item>
           </layout>
          </item>
          <item row="1" column="0">
           <widget class="QLabel" name="msLabel">
            <property name="text">
             <string>多光谱影像:</string>
            </property>
           </widget>
          </item>
          <item row="1" column="1">
           <layout class="QHBoxLayout" name="msLayout">
            <item>
             <widget class="QLineEdit" name="msPathEdit">
              <property name="readOnly">
               <bool>true</bool>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QPushButton" name="msBrowseBtn">
              <property name="text">
               <string>浏览...</string>
              </property>
             </widget>
            </item>
           </layout>
          </item>
         </layout>
        </widget>
       </item>
       <item>
        <widget class="QGroupBox" name="outputGroup">
         <property name="title">
          <string>输出路径</string>
         </property>
         <layout class="QVBoxLayout" name="outputLayout">
          <item>
           <layout class="QHBoxLayout" name="outputPathLayout">
            <item>
             <widget class="QLineEdit" name="outputPathEdit">
              <property name="placeholderText">
               <string>融合结果保存路径（留空则关闭后手动选择）</string>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QPushButton" name="outputBrowseBtn">
              <property name="text">
               <string>浏览...</string>
              </property>
             </widget>
            </item>
           </layout>
          </item>
         </layout>
        </widget>
       </item>
       <item>
        <widget class="QGroupBox" name="algorithmGroup">
         <property name="title">
          <string>融合算法</string>
         </property>
         <layout class="QVBoxLayout" name="algorithmLayout">
          <item>
           <widget class="QComboBox" name="algorithmCombo">
            <item>
             <property name="text">
              <string>PCA (主成分分析) 融合</string>
             </property>
            </item>
            <item>
             <property name="text">
              <string>HIS (色度-亮度-饱和度) 变换融合</string>
             </property>
            </item>
           </widget>
          </item>
         </layout>
        </widget>
       </item>
       <item>
        <widget class="QGroupBox" name="paramGroup">
         <property name="title">
          <string>融合参数</string>
         </property>
         <layout class="QFormLayout" name="paramFormLayout">
          <item row="0" column="0">
           <widget class="QLabel" name="weightLabel">
            <property name="text">
             <string>权重系数:</string>
            </property>
           </widget>
          </item>
          <item row="0" column="1">
           <layout class="QHBoxLayout" name="weightLayout">
            <item>
             <widget class="QSlider" name="weightSlider">
              <property name="minimum">
               <number>0</number>
              </property>
              <property name="maximum">
               <number>100</number>
              </property>
              <property name="value">
               <number>100</number>
              </property>
              <property name="orientation">
               <enum>Qt::Horizontal</enum>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QDoubleSpinBox" name="weightSpinBox">
              <property name="minimum">
               <double>0.00</double>
              </property>
              <property name="maximum">
               <double>1.00</double>
              </property>
              <property name="singleStep">
               <double>0.05</double>
              </property>
              <property name="value">
               <double>1.00</double>
              </property>
             </widget>
            </item>
           </layout>
          </item>
          <item row="1" column="0">
           <widget class="QLabel" name="interpLabel">
            <property name="text">
             <string>插值方法:</string>
            </property>
           </widget>
          </item>
          <item row="1" column="1">
           <widget class="QComboBox" name="interpCombo">
            <item>
             <property name="text">
              <string>最近邻插值</string>
             </property>
            </item>
            <item>
             <property name="text">
              <string>双线性插值</string>
             </property>
            </item>
            <item>
             <property name="text">
              <string>双三次插值</string>
             </property>
            </item>
           </widget>
          </item>
          <item row="2" column="0">
           <widget class="QLabel" name="histLabel">
            <property name="text">
             <string>直方图匹配:</string>
            </property>
           </widget>
          </item>
          <item row="2" column="1">
           <widget class="QCheckBox" name="histCheckBox">
            <property name="text">
             <string>启用全色影像直方图匹配</string>
            </property>
            <property name="checked">
             <bool>true</bool>
            </property>
           </widget>
          </item>
          <item row="3" column="0">
           <widget class="QLabel" name="adaptiveLabel">
            <property name="text">
             <string>自适应滤波:</string>
            </property>
           </widget>
          </item>
          <item row="3" column="1">
           <widget class="QCheckBox" name="adaptiveCheckBox">
            <property name="text">
             <string>启用自适应滤波</string>
            </property>
           </widget>
          </item>
         </layout>
        </widget>
       </item>
       <item>
        <widget class="QGroupBox" name="presetGroup">
         <property name="title">
          <string>参数预设</string>
         </property>
         <layout class="QVBoxLayout" name="presetLayout">
          <item>
           <widget class="QComboBox" name="presetCombo">
            <item>
             <property name="text">
              <string>默认参数</string>
             </property>
            </item>
            <item>
             <property name="text">
              <string>高空间细节</string>
             </property>
            </item>
            <item>
             <property name="text">
              <string>高光谱保真</string>
             </property>
            </item>
            <item>
             <property name="text">
              <string>均衡模式</string>
             </property>
            </item>
           </widget>
          </item>
          <item>
           <layout class="QHBoxLayout" name="presetBtnLayout">
            <item>
             <widget class="QPushButton" name="savePresetBtn">
              <property name="text">
               <string>保存当前参数</string>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QPushButton" name="deletePresetBtn">
              <property name="text">
               <string>删除预设</string>
              </property>
             </widget>
            </item>
           </layout>
          </item>
         </layout>
        </widget>
       </item>
       <item>
        <layout class="QHBoxLayout" name="actionLayout">
         <item>
          <widget class="QPushButton" name="executeBtn">
           <property name="text">
            <string>执行融合</string>
           </property>
           <property name="minimumHeight">
            <number>36</number>
           </property>
          </widget>
         </item>
         <item>
          <widget class="QPushButton" name="previewBtn">
           <property name="text">
            <string>参数预览</string>
           </property>
           <property name="minimumHeight">
            <number>36</number>
           </property>
          </widget>
         </item>
        </layout>
       </item>
      </layout>
     </widget>
     <widget class="QTabWidget" name="resultTabWidget">
      <property name="currentIndex">
       <number>0</number>
      </property>
      <widget class="QWidget" name="previewTab">
       <attribute name="title">
        <string>影像预览</string>
       </attribute>
       <layout class="QVBoxLayout" name="previewTabLayout">
        <item>
         <widget class="QFrame" name="previewToolbarFrame">
          <property name="maximumSize">
           <size>
            <width>16777215</width>
            <height>36</height>
           </size>
          </property>
          <layout class="QHBoxLayout" name="previewToolbarLayout">
           <property name="leftMargin">
            <number>0</number>
           </property>
           <property name="topMargin">
            <number>0</number>
           </property>
           <property name="rightMargin">
            <number>0</number>
           </property>
           <property name="bottomMargin">
            <number>0</number>
           </property>
           <item>
            <widget class="QToolButton" name="zoomInBtn">
             <property name="text">
              <string>放大</string>
             </property>
             <property name="toolTip">
              <string>放大 (Ctrl+滚轮)</string>
             </property>
            </widget>
           </item>
           <item>
            <widget class="QToolButton" name="zoomOutBtn">
             <property name="text">
              <string>缩小</string>
             </property>
             <property name="toolTip">
              <string>缩小</string>
             </property>
            </widget>
           </item>
           <item>
            <widget class="QToolButton" name="zoomFitBtn">
             <property name="text">
              <string>适应窗口</string>
             </property>
             <property name="toolTip">
              <string>适应窗口</string>
             </property>
            </widget>
           </item>
           <item>
            <widget class="QToolButton" name="zoomOriginalBtn">
             <property name="text">
              <string>原始大小</string>
             </property>
             <property name="toolTip">
              <string>100%</string>
             </property>
            </widget>
           </item>
           <item>
