             <property name="orientation">
              <enum>Qt::Horizontal</enum>
             </property>
            </spacer>
           </item>
           <item>
            <widget class="QLabel" name="zoomLevelLabel">
             <property name="text">
              <string>100%</string>
             </property>
             <property name="minimumSize">
              <size>
               <width>60</width>
               <height>0</height>
              </size>
             </property>
             <property name="alignment">
              <set>Qt::AlignCenter</set>
             </property>
            </widget>
           </item>
          </layout>
         </widget>
        </item>
        <item>
         <widget class="QTabWidget" name="previewSubTab">
          <property name="tabPosition">
           <enum>QTabWidget::North</enum>
          </property>
          <widget class="QWidget" name="panPreviewTab">
           <attribute name="title">
            <string>全色影像</string>
           </attribute>
           <layout class="QVBoxLayout" name="panPreviewLayout">
            <item>
             <widget class="QGraphicsView" name="panPreviewView"/>
