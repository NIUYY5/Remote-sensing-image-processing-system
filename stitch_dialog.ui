             <string>特征检测:</string>
            </property>
           </widget>
          </item>
          <item row="0" column="1">
           <widget class="QComboBox" name="featureCombo">
            <item>
             <property name="text">
              <string>SIFT-like（类SIFT）</string>
             </property>
            </item>
            <item>
             <property name="text">
              <string>FAST角点</string>
             </property>
            </item>
            <item>
             <property name="text">
              <string>Harris角点</string>
             </property>
            </item>
           </widget>
          </item>
          <item row="1" column="0">
           <widget class="QLabel" name="matchLabel">
            <property name="text">
             <string>匹配方法:</string>
            </property>
           </widget>
          </item>
          <item row="1" column="1">
           <widget class="QComboBox" name="matchCombo">
            <item>
             <property name="text">
              <string>归一化互相关 (NCC)</string>
             </property>
            </item>
            <item>
             <property name="text">
              <string>平方差和 (SSD)</string>
             </property>
            </item>
           </widget>
          </item>
