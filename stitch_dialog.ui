            <item>
             <widget class="QPushButton" name="img2BrowseBtn">
              <property name="text">
               <string>浏览...</string>
              </property>
             </widget>
            </item>
           </layout>
          </item>
         </layout>
        </widget>
       </item>
       <item>
        <widget class="QGroupBox" name="outputGroup">
         <property name="title">
          <string>输出路径</string>
         </property>
         <layout class="QVBoxLayout" name="outputLayout">
          <item>
           <layout class="QHBoxLayout" name="outputPathLayout">
            <item>
             <widget class="QLineEdit" name="outputPathEdit">
              <property name="placeholderText">
               <string>拼接结果保存路径（留空则关闭后手动选择）</string>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QPushButton" name="outputBrowseBtn">
              <property name="text">
               <string>浏览...</string>
              </property>
             </widget>
            </item>
           </layout>
          </item>
         </layout>
        </widget>
       </item>
       <item>
        <widget class="QGroupBox" name="algorithmGroup">
         <property name="title">
          <string>拼接算法</string>
         </property>
         <layout class="QVBoxLayout" name="algorithmLayout">
          <item>
           <widget class="QComboBox" name="algorithmCombo">
            <item>
             <property name="text">
              <string>传统拼接（特征匹配+线性渐变融合）</string>
             </property>
            </item>
            <item>
             <property name="text">
              <string>深度学习拼接（多尺度边缘感知融合）</string>
             </property>
            </item>
           </widget>
          </item>
          <item>
           <widget class="QCheckBox" name="rpcModeCheckBox">
            <property name="text">
             <string>RPC有理多项式精确拼接（基于RPC参数文件）</string>
            </property>
            <property name="toolTip">
             <string>启用后读取影像对应的RPC(.RPB/.RPC/_RPC.TXT)有理多项式系数文件进行高精度地理坐标配准拼接</string>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QGroupBox" name="rpcParamGroup">
            <property name="title">
             <string>RPC参数</string>
            </property>
            <layout class="QFormLayout" name="rpcParamFormLayout">
             <item row="0" column="0">
              <widget class="QLabel" name="rpcHeightLabel">
               <property name="text">
                <string>参考高程(m):</string>
               </property>
              </widget>
             </item>
             <item row="0" column="1">
              <widget class="QDoubleSpinBox" name="rpcHeightSpinBox">
               <property name="minimum">
                <double>-9999.00</double>
               </property>
               <property name="maximum">
                <double>9999.00</double>
               </property>
               <property name="singleStep">
                <double>10.00</double>
               </property>
               <property name="value">
                <double>0.00</double>
               </property>
              </widget>
             </item>
             <item row="1" column="0">
              <widget class="QLabel" name="rpcResolutionLabel">
               <property name="text">
                <string>输出分辨率(°):</string>
               </property>
              </widget>
             </item>
             <item row="1" column="1">
              <widget class="QDoubleSpinBox" name="rpcResolutionSpinBox">
               <property name="decimals">
                <number>10</number>
               </property>
               <property name="minimum">
                <double>0.0000000000</double>
               </property>
               <property name="maximum">
                <double>1.0000000000</double>
               </property>
               <property name="singleStep">
                <double>0.0000100000</double>
               </property>
               <property name="value">
                <double>0.0000000000</double>
               </property>
              </widget>
             </item>
             <item row="2" column="0">
              <widget class="QLabel" name="img1RpcLabel">
               <property name="text">
                <string>影像1 RPC文件:</string>
               </property>
              </widget>
             </item>
             <item row="2" column="1">
              <layout class="QHBoxLayout" name="img1RpcLayout">
               <item>
                <widget class="QLineEdit" name="img1RpcPathEdit">
                 <property name="readOnly">
                  <bool>true</bool>
                 </property>
                 <property name="placeholderText">
                  <string>自动搜索或手动指定</string>
                 </property>
                </widget>
               </item>
               <item>
                <widget class="QPushButton" name="img1RpcBrowseBtn">
                 <property name="text">
                  <string>浏览...</string>
                 </property>
                </widget>
               </item>
              </layout>
             </item>
             <item row="3" column="0">
              <widget class="QLabel" name="img2RpcLabel">
               <property name="text">
                <string>影像2 RPC文件:</string>
               </property>
              </widget>
             </item>
             <item row="3" column="1">
              <layout class="QHBoxLayout" name="img2RpcLayout">
               <item>
                <widget class="QLineEdit" name="img2RpcPathEdit">
                 <property name="readOnly">
                  <bool>true</bool>
                 </property>
                 <property name="placeholderText">
                  <string>自动搜索或手动指定</string>
                 </property>
                </widget>
               </item>
               <item>
                <widget class="QPushButton" name="img2RpcBrowseBtn">
                 <property name="text">
                  <string>浏览...</string>
                 </property>
                </widget>
               </item>
              </layout>
             </item>
            </layout>
           </widget>
          </item>
          <item>
           <widget class="QCheckBox" name="geoCoordinateCheckBox">
            <property name="text">
             <string>使用地理坐标精确拼接（基于影像嵌入的地理坐标元数据）</string>
            </property>
            <property name="toolTip">
             <string>启用后直接使用影像文件中的地理坐标信息（GeoTIFF标签、World文件等）进行精确配准拼接，无需特征匹配</string>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QLabel" name="geoInfoLabel">
            <property name="text">
             <string></string>
            </property>
            <property name="wordWrap">
             <bool>true</bool>
            </property>
            <property name="styleSheet">
             <string>color: #888; font-size: 11px;</string>
            </property>
           </widget>
          </item>
         </layout>
        </widget>
       </item>
       <item>
        <widget class="QGroupBox" name="paramGroup">
         <property name="title">
