             <property name="text">
              <string>线性渐变融合</string>
             </property>
            </item>
            <item>
             <property name="text">
              <string>简单平均融合</string>
             </property>
            </item>
            <item>
             <property name="text">
              <string>多频带融合</string>
             </property>
            </item>
           </widget>
          </item>
          <item row="4" column="0">
           <widget class="QLabel" name="blendWidthLabel">
            <property name="text">
             <string>融合宽度:</string>
            </property>
           </widget>
          </item>
          <item row="4" column="1">
           <widget class="QSpinBox" name="blendWidthSpinBox">
            <property name="minimum">
             <number>4</number>
            </property>
            <property name="maximum">
             <number>512</number>
            </property>
            <property name="value">
             <number>64</number>
            </property>
           </widget>
          </item>
         </layout>
        </widget>
       </item>
       <item>
        <layout class="QHBoxLayout" name="actionLayout">
