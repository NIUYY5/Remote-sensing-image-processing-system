          </item>
          <item row="2" column="1">
           <widget class="QDoubleSpinBox" name="ransacSpinBox">
            <property name="minimum">
             <double>0.50</double>
            </property>
            <property name="maximum">
             <double>20.00</double>
            </property>
            <property name="singleStep">
             <double>0.50</double>
            </property>
            <property name="value">
             <double>3.00</double>
            </property>
           </widget>
          </item>
          <item row="3" column="0">
           <widget class="QLabel" name="blendLabel">
            <property name="text">
             <string>融合方式:</string>
            </property>
           </widget>
          </item>
          <item row="3" column="1">
           <widget class="QComboBox" name="blendCombo">
